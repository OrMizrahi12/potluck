# Copy to .env.local. Local Postgres 18 over the Unix socket, as your OS user:
DATABASE_URL=postgresql:///potluck?host=/var/run/postgresql
# Optional: where rate lookups ask for exchange rates when run locally.
# Unset, they ask the fake Potluck serves itself (src/group/fake-frankfurter.ts).
# Any Vercel deployment asks Frankfurter (https://api.frankfurter.dev/v2) and
# ignores this.
# RATE_SOURCE_URL=https://api.frankfurter.dev/v2
